# Vorlage für `.env` neben docker-compose.plesk.yml. Nach `.env` kopieren und
# ausfüllen; `.env` und der Ordner `geheim/` sind in .gitignore.
#
# Ohne Apple- und Google-Angaben läuft der Dienst trotzdem: Er liefert die App
# aus, die Wallet-Knöpfe bleiben verborgen.

# Port auf dem Loopback des Servers, an den die Plesk-Domain weiterleitet;
# muss zu deploy/plesk/nginx-direktiven.conf passen.
DA_PLESK_PORT=8086

# Adresse, unter der die App erreichbar ist (ohne Schrägstrich am Ende).
DA_ADRESSE=https://dienstausweis.example.org

# Name des Ausstellers, wie Apple Wallet ihn zeigt.
DA_ORGANISATION=Dienstausweis

# Pässe je IP-Adresse in zehn Minuten.
DA_GRENZE=20

# Nur wenn die App woanders liegt (z. B. GitHub Pages) und diesen Dienst zum
# Signieren ruft: deren Adressen, durch Komma getrennt.
DA_URSPRUENGE=

# --- Apple Wallet (README, „Apple Wallet einrichten“) ---
# Pass Type ID und Team ID aus dem Apple-Developer-Konto.
DA_APPLE_PASS_TYP=
DA_APPLE_TEAM=
# Dateien im Ordner geheim/, im Container unter /geheim/ (PEM).
DA_APPLE_ZERTIFIKAT=/geheim/pass.pem
DA_APPLE_SCHLUESSEL=/geheim/pass.key
DA_APPLE_SCHLUESSEL_PASSWORT=
DA_APPLE_WWDR=/geheim/wwdr.pem

# --- Google Wallet (README, „Google Wallet einrichten“) ---
# Issuer ID aus der Google Pay & Wallet Console.
DA_GOOGLE_AUSSTELLER=
# Kennung der Passklasse ohne Issuer ID.
DA_GOOGLE_KLASSE=dienstausweis
# Schlüsseldatei des Dienstkontos (JSON).
DA_GOOGLE_DIENSTKONTO=/geheim/google-dienstkonto.json
